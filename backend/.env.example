# Copy this file to .env and adjust (never commit .env)

# --- OCR ---
# Windows: path to tesseract.exe if it is not on PATH
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# --- LLM providers (free tiers; add the keys you have) ---
GROQ_API_KEY=
GEMINI_API_KEY=
# Order of providers to try. If the first fails or is rate-limited, the next is used.
LLM_CHAIN=groq,gemini
# Optional model overrides (names change over time; check each provider's model list)
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_MODEL=gemini-2.5-flash

# --- Server ---
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_MB=10
MAX_PDF_PAGES=5
